{
  "name": "fravelz-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "style": "pnpm run format && pnpm run lint:fix",
    "react:doctor": "react-doctor . --verbose",
    "lighthouse:local": "unlighthouse --site http://localhost:3000",
    "lighthouse:budget": "node scripts/lighthouse-budget.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.64.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "lighthouse": "^13.5.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "unlighthouse": "^0.18.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
